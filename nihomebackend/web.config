<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS hosting for `dotnet publish` (in-process). The publish step keeps this file and
  fills in the ASP.NET Core module settings.

  requestLimits: IIS request filtering rejects request bodies above 30,000,000 bytes
  (~28.6 MB) before the app sees them. Uploads are limited per module in Settings
  (project documents up to 100 MB, contracts up to 5 GB), so IIS is raised to its
  maximum (uint, ~4 GB) and the app enforces the real limits. Files above ~4 GB need
  chunked upload.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\nihomebackend.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="4294967295" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
