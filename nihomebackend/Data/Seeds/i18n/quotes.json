  {"key": "quotes.paste.needsPermission", "category": "quotes", "vi": "Trình duyệt chưa cho phép truy cập clipboard.", "en": "Clipboard access blocked by the browser.", "zh": "浏览器阻止了剪贴板访问。", "ja": "ブラウザがクリップボードアクセスを拒否しました。"},
  {"key": "quotes.paste.title", "category": "quotes", "vi": "Dán bảng khối lượng từ Excel", "en": "Paste bill of quantities from Excel", "zh": "从 Excel 粘贴工程量清单", "ja": "Excelから数量明細を貼り付け"},
  {"key": "quotes.paste.instructions", "category": "quotes", "vi": "Sao chép các ô trong Excel, bấm vào vùng bên dưới rồi nhấn ⌘V hoặc Ctrl+V. Không cần cấp quyền đọc clipboard cho trình duyệt.", "en": "Copy the Excel cells, click the area below, then press ⌘V or Ctrl+V. Browser clipboard permission is not required.", "zh": "复制 Excel 单元格，点击下方区域，然后按 ⌘V 或 Ctrl+V。无需授予浏览器读取剪贴板的权限。", "ja": "Excelのセルをコピーし、下の欄をクリックして⌘VまたはCtrl+Vを押してください。ブラウザのクリップボード読取権限は不要です。"},
  {"key": "quotes.paste.columns", "category": "quotes", "vi": "Thứ tự cột: [Mã - tùy chọn] · Hạng mục · Đơn vị · Khối lượng · Đơn giá", "en": "Column order: [Code - optional] · Item name · Unit · Quantity · Unit price", "zh": "列顺序：[编号 - 可选] · 项目名称 · 单位 · 数量 · 单价", "ja": "列順：[コード - 任意]・項目名・単位・数量・単価"},
  {"key": "quotes.paste.example", "category": "quotes", "vi": "Ví dụ: BOQ-01 · Bê tông móng M300 · m3 · 25 · 1.450.000", "en": "Example: BOQ-01 · Foundation concrete M300 · m3 · 25 · 1,450,000", "zh": "示例：BOQ-01 · M300 基础混凝土 · m3 · 25 · 1,450,000", "ja": "例：BOQ-01・基礎コンクリート M300・m3・25・1,450,000"},
  {"key": "quotes.paste.numberHint", "category": "quotes", "vi": "Khối lượng có một dấu và đúng 3 chữ số phía sau (ví dụ 1.234) là mơ hồ nên sẽ bị từ chối. Hãy dùng 1234 cho số nguyên hoặc 1.2340 cho số thập phân.", "en": "A quantity with one separator and exactly 3 following digits (for example 1.234) is ambiguous and will be rejected. Use 1234 for a whole number or 1.2340 for a decimal.", "zh": "仅含一个分隔符且其后正好有 3 位数字的数量（例如 1.234）含义不明确，将被拒绝。整数请使用 1234，小数请使用 1.2340。", "ja": "区切り記号が1つで、その後がちょうど3桁の数量（例：1.234）は曖昧なため拒否されます。整数は1234、小数は1.2340と入力してください。"},
  {"key": "quotes.paste.placeholder", "category": "quotes", "vi": "Dán các ô đã sao chép từ Excel vào đây...", "en": "Paste the copied Excel cells here...", "zh": "在此粘贴从 Excel 复制的单元格...", "ja": "Excelからコピーしたセルをここに貼り付け..."},
  {"key": "quotes.paste.validCount", "category": "quotes", "vi": "{count} dòng hợp lệ sẽ được thêm.", "en": "{count} valid rows will be added.", "zh": "将添加 {count} 行有效数据。", "ja": "有効な{count}行を追加します。"},
  {"key": "quotes.paste.invalidRows", "category": "quotes", "vi": "Dòng chưa hợp lệ: {rows}. Mỗi dòng phải đủ cột, có hạng mục/đơn vị, khối lượng > 0 và đơn giá ≥ 0.", "en": "Invalid rows: {rows}. Each row needs all columns, item/unit, quantity > 0, and unit price ≥ 0.", "zh": "无效行：{rows}。每行必须列数完整、包含项目/单位，数量 > 0，单价 ≥ 0。", "ja": "無効な行：{rows}。各行に全列、項目名・単位、0より大きい数量、0以上の単価が必要です。"},
  {"key": "quotes.paste.confirm", "category": "quotes", "vi": "Thêm {count} dòng", "en": "Add {count} rows", "zh": "添加 {count} 行", "ja": "{count}行を追加"},
