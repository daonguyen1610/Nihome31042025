  { "key": "surveys.media.locationUnavailable", "category": "surveys", "vi": "Thiết bị không hỗ trợ lấy vị trí. Hãy nhập vĩ độ và kinh độ thủ công, VD: 10.776900 và 106.700900.", "en": "Location is unavailable. Enter latitude and longitude manually, e.g. 10.776900 and 106.700900.", "zh": "设备无法获取位置。请手动输入纬度和经度，例如 10.776900 和 106.700900。", "ja": "位置情報を取得できません。緯度・経度を手入力してください（例: 10.776900、106.700900）。" },
  { "key": "surveys.media.locationDenied", "category": "surveys", "vi": "Không thể lấy vị trí. Hãy cấp quyền định vị hoặc nhập thủ công, VD: 10.776900 và 106.700900.", "en": "Could not get location. Allow location access or enter it manually, e.g. 10.776900 and 106.700900.", "zh": "无法获取位置。请允许位置权限或手动输入，例如 10.776900 和 106.700900。", "ja": "位置情報を取得できません。権限を許可するか手入力してください（例: 10.776900、106.700900）。" },
  { "key": "surveys.media.validation.fileRequired", "category": "surveys", "vi": "Tệp khảo sát là bắt buộc. Hãy chọn ảnh hoặc tài liệu trước khi tải lên.", "en": "A survey file is required. Choose a photo or document before uploading.", "zh": "勘察文件为必填项。上传前请选择照片或文件。", "ja": "調査ファイルは必須です。アップロード前に写真または資料を選択してください。" },
  { "key": "surveys.media.validation.format", "category": "surveys", "vi": "Định dạng không được hỗ trợ. Chỉ chấp nhận JPG, JPEG, PNG, HEIC, MP4, MOV, PDF, DWG hoặc RVT.", "en": "Unsupported format. Use JPG, JPEG, PNG, HEIC, MP4, MOV, PDF, DWG or RVT.", "zh": "不支持此格式。仅接受 JPG、JPEG、PNG、HEIC、MP4、MOV、PDF、DWG 或 RVT。", "ja": "未対応の形式です。JPG、JPEG、PNG、HEIC、MP4、MOV、PDF、DWG、RVT を使用してください。" },
  { "key": "surveys.media.validation.size", "category": "surveys", "vi": "Tệp khảo sát không được vượt quá 100 MiB. Hãy chọn tệp nhỏ hơn.", "en": "Survey files must not exceed 100 MiB. Choose a smaller file.", "zh": "勘察文件不得超过 100 MiB。请选择较小的文件。", "ja": "調査ファイルは 100 MiB 以下にしてください。より小さいファイルを選択してください。" },
  { "key": "surveys.media.validation.coordinates", "category": "surveys", "vi": "Vĩ độ và kinh độ phải nhập cùng nhau và đúng phạm vi, VD: 10.776900 và 106.700900.", "en": "Latitude and longitude must be entered together and within range, e.g. 10.776900 and 106.700900.", "zh": "纬度和经度必须同时输入且在有效范围内，例如 10.776900 和 106.700900。", "ja": "緯度と経度は有効範囲内で両方入力してください（例: 10.776900、106.700900）。" },
  { "key": "surveys.media.deleteTitle", "category": "surveys", "vi": "Xoá tệp khảo sát?", "en": "Delete survey file?", "zh": "删除勘察文件？", "ja": "調査ファイルを削除しますか？" },
  { "key": "surveys.media.deleteDescription", "category": "surveys", "vi": "Tệp sẽ bị xoá khỏi vùng lưu trữ riêng. Nếu đã đồng bộ, bản sao Google Drive sẽ được chuyển vào thùng rác và quản trị viên Drive có thể khôi phục.", "en": "The file will be removed from private storage. If synced, the Google Drive copy will be moved to trash and can be restored by a Drive administrator.", "zh": "文件将从私有存储中删除。若已同步，Google Drive 副本将移至回收站，并可由 Drive 管理员恢复。", "ja": "ファイルは非公開ストレージから削除されます。同期済みの場合、Google Drive のコピーはゴミ箱へ移動され、Drive 管理者が復元できます。" },

