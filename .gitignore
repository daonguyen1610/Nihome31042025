# Ignore backend build artifacts
nihomebackend/bin/**
nihomebackend/obj/**
# Ignore publish folder since we will generate it from the source code and deploy to hosting
nihomebackend/publish
nihomebackend/bin/
nihomebackend/obj/
nihomebackend.tests/bin/**
nihomebackend.tests/obj/**
.amazonq
.agents
skills-lock.json
# Deployment config
deployment-config/output
deployment-config/output/publish-release/
deployment-config/output/publish-release.zip
nihomebackend.integration.tests/bin/
nihomebackend.integration.tests/obj/
TestResults/

# Backend wwwroot is reserved for backend-managed static assets only
# (user-uploaded images, CVs, process-assets). The React SPA is built to
# nihomeweb/dist and served via WebRootPath — never copy dist/* here.
nihomebackend/wwwroot/index.html
nihomebackend/wwwroot/favicon.svg
nihomebackend/wwwroot/assets/

# Capability-document placeholders are regenerated at boot by
# SampleCrmDataSeeder — never commit the generated PDFs.
nihomebackend/wwwroot/files/capability/

# Contract attachments / VO uploads are user uploads at runtime — never
# commit them into the repo. The dev seeder points at a placeholder path
# but doesn't drop physical files.
nihomebackend/wwwroot/files/contracts/

# Quote documents are user uploads at runtime.
nihomebackend/wwwroot/files/quotes/

# Managed operational business documents are user uploads at runtime.
nihomebackend/wwwroot/files/business-documents/

# Tender documents are user uploads at runtime, same as the rest above.
nihomebackend/wwwroot/files/tenders/

# Customer documents, likewise. (files/design/ is deliberately tracked — it
# holds committed sample assets, not runtime uploads.)
nihomebackend/wwwroot/files/customers/

# Private survey media staging; files are retained locally after Drive sync.
nihomebackend/wwwroot/files/survey-media/

.DS_Store
deployment-config/.DS_Store
test-results
